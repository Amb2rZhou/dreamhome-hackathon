{
  "regions": ["hkg1"],
  "redirects": [
    {
      "source": "/",
      "destination": "/prototype/pages/discover/app/index.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/asset-cdn/:path*",
      "destination": "https://raw.githubusercontent.com/Amb2rZhou/dreamhome-hackathon/017650f/datasets/available-assets-v1/assets/:path*"
    },
    {
      "source": "/dreamhome-api/api/jobs/:jobId",
      "destination": "/api/dreamhome-jobs/:jobId"
    },
    {
      "source": "/dreamhome-api/:path*",
      "destination": "http://218.244.156.128:8000/:path*"
    }
  ],
  "functions": {
    "api/photo-to-3d.js": { "maxDuration": 60 },
    "api/selection-to-3d.js": { "maxDuration": 60 },
    "api/jobs/[id].js": { "maxDuration": 30 },
    "api/dreamhome-jobs/[id].js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=()" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/prototype/pages/(.*)/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/prototype/pages/discover/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/prototype/pages/discover/app/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/prototype/pages/discover/app/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(asset-cdn|vendor)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=2592000" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/prototype/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=2592000" }
      ]
    },
    {
      "source": "/(videos|models|mascot-motion)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=2592000" }
      ]
    },
    {
      "source": "/(.*).(png|jpg|jpeg|webp|avif|svg|woff2|otf)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=2592000" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
