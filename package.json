{
  "name": "dreamhome-feed",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "audit:assets": "node tools/audit-static-assets.mjs --write",
    "check:asset-paths": "node tools/audit-static-assets.mjs --check",
    "check:performance-budget": "node tools/check-performance-budget.mjs",
    "check:release-data": "node tools/check-release-data.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:asset-catalog": "node tools/build-structured-asset-catalog.mjs",
    "build:frontend-asset-catalog": "node tools/sync-frontend-asset-catalog.mjs",
    "build:discover": "tsc -b && vite build --config vite.discover.config.ts && cp -R public/. web/ && node tools/finalize-discover-entry.mjs",
    "lint": "oxlint src",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@types/three": "^0.185.1",
    "onnxruntime-web": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^26.1.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.6"
  }
}
